# Right Team Digital: Apache config for rightteam.in on Hostinger (Git deployment).
# Hostinger copies the WHOLE repo into public_html, so this file decides what the public
# may open. Only the pages, assets/, robots.txt and sitemap.xml are served; everything
# else (tools/, supabase/, docs/, .git, README.md ...) answers "404 not found".

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # always HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # one address: www.rightteam.in -> rightteam.in
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # one address per page (Search Console "duplicate" / "not found" fixes)
  # /index.html -> /   (THE_REQUEST so DirectoryIndex's internal lookup doesn't loop)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [L,R=301]
  # /services or /services/ -> /services.html, /services.html/ -> /services.html (only for real pages)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)(?:\.html)?/$ /$1.html [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([A-Za-z0-9_-]+)$ /$1.html [L,R=301]

  # ---- old site addresses -> new pages (301). Add one line per old page, e.g.:
  # RewriteRule ^contact-us/?$ /start.html [L,R=301]
  # RewriteRule ^services/gst-registration/?$ /services.html [L,R=301]

  # ---- allowlist: anything not listed here is answered with 404
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} !^/[A-Za-z0-9_-]+\.html$
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !^/(robots\.txt|sitemap\.xml|favicon\.ico)$
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ - [R=404,L]

  # hidden files inside allowed folders (.DS_Store, .gitkeep ...)
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # raise to max-age=31536000 once HTTPS has worked for a week
  Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"

  # pages: always check for a fresh copy; scripts/styles carry ?v= so they can be cached
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml
</IfModule>
