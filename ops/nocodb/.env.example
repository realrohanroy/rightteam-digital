# Copy to .env (git-ignored) and fill in.
# Connection string for the ops_nocodb role created in docs/ONBOARDING.md step 4.
# Supabase -> Project Settings -> Database -> Connection string (Session pooler), swap in the role + password.
NOCODB_PG_URL=postgresql://ops_nocodb.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
NC_AUTH_JWT_SECRET=<long random string>
